MODULE    = wineohos.drv
UNIXLIB   = wineohos.so
IMPORTS   = ntoskrnl win32u
EXTRAINCL = -I$(top_srcdir)/ohos/adapter/include
UNIX_LIBS = -lwin32u $(PTHREAD_LIBS) $(OHOS_LIBS) $(ADAPTER_LIBS)

SOURCES = \
	clipboard.c \
	device.c \
	dllmain.c \
	ime.c \
	init.c \
	keyboard.c \
	opengl.c \
	window.c
