{
    "app": {
        "products": [
            {
                "name": "default",
                "signingConfig": "default",
                "compatibleSdkVersion": "6.0.0(20)",
                "runtimeOS": "HarmonyOS",
                "buildOption": {
                    "nativeLib": {
                        "collectAllLibs": true
                    }
                },
                "targetSdkVersion": "6.1.1(24)"
            }
        ],
        "buildModeSet": [
            {
                "name": "debug"
            },
            {
                "name": "release"
            }
        ]
    },
    "modules": [
        {
            "name": "entry",
            "srcPath": "./entry",
            "targets": [
                {
                    "name": "default",
                    "applyToProducts": [
                        "default"
                    ]
                }
            ]
        },
        {
            "name": "wine_engine",
            "srcPath": "./wine_engine"
        }
    ]
}
