{
  "apiType": "stageMode",
  "buildOption": {
    "nativeLib": {
      "filter": {
        // This file is a linker script; libc++_shared.so is the runtime library.
        "excludes": ["**/libc++.so"]
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": true,
            "files": [
              "./obfuscation-rules.txt"
            ]
          },
          "consumerFiles": [
            "./consumer-rules.txt"
          ]
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
